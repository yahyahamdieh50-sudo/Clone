{% stylesheet %}
  .static-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 60px 40px 100px;
  }

  .static-page__title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, 48px);
    color: var(--color-white);
    font-weight: 400;
    text-align: center;
    margin-bottom: 50px;
  }

  .static-page__content {
    color: var(--color-text);
    line-height: 1.9;
    font-size: 16px;
  }

  .static-page__content h2,
  .static-page__content h3 {
    color: var(--color-white);
    font-family: var(--font-serif);
    margin-top: 2rem;
  }

  .static-page__content a { color: var(--color-gold); }

  @media (max-width: 768px) {
    .static-page { padding: 36px 20px 70px; }
  }
{% endstylesheet %}

<article class="static-page">
  <h1 class="static-page__title">{{ page.title }}</h1>
  <div class="static-page__content">
    {{ page.content }}
  </div>
</article>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
