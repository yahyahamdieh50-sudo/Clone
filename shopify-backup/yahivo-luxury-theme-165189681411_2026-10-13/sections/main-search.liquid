{% stylesheet %}
  .search-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px 100px;
  }

  .search-page__title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, 48px);
    color: var(--color-white);
    font-weight: 400;
    text-align: center;
    margin-bottom: 40px;
  }

  .search-page__form {
    display: flex;
    max-width: 560px;
    margin: 0 auto 60px;
  }

  .search-page__input {
    flex: 1;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    border-right: none;
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 16px 18px;
    border-radius: 0;
  }

  .search-page__input:focus { outline: none; border-color: var(--color-gold); }

  .search-page__submit {
    padding: 16px 32px;
    border: 1px solid var(--color-gold);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 0;
  }

  .search-page__meta {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--color-text);
    margin-bottom: 44px;
  }

  .search-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 30px;
  }

  @media (max-width: 768px) {
    .search-page { padding: 36px 20px 70px; }
    .search-page__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
{% endstylesheet %}

<div class="search-page">
  <h1 class="search-page__title">{{ 'general.search.search' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" class="search-page__form" role="search">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      class="search-page__input"
      aria-label="{{ 'general.search.search' | t }}"
    >
    <input type="hidden" name="type" value="product">
    <button type="submit" class="search-page__submit">{{ 'general.search.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      {%- if search.results_count > 0 -%}
        <p class="search-page__meta">
          {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
        </p>
        <div class="search-page__grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="search-page__meta">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" role="navigation">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">&larr; {{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }} &rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search page",
  "settings": []
}
{% endschema %}
