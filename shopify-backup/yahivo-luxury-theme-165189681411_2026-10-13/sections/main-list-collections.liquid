{% stylesheet %}
  .collections-list {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px 100px;
  }

  .collections-list__title {
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, 56px);
    color: var(--color-white);
    font-weight: 400;
    text-align: center;
    margin-bottom: 60px;
  }

  .collections-list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
  }

  .collections-list__card {
    position: relative;
    display: block;
    background: var(--color-black);
    border: 1px solid var(--color-border);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .collections-list__card:hover { border-color: var(--color-gold); opacity: 1; }
  .collections-list__card img { width: 100%; height: 320px; object-fit: cover; display: block; opacity: 0.85; }

  .collections-list__card-info { padding: 24px; }

  .collections-list__card-title {
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--color-white);
    margin-bottom: 6px;
  }

  .collections-list__card-count {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--color-gold);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .collections-list { padding: 36px 20px 70px; }
  }
{% endstylesheet %}

<div class="collections-list">
  <h1 class="collections-list__title">Collections</h1>
  <div class="collections-list__grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="collections-list__card">
          {%- liquid
            assign col_image = collection.image | default: collection.products.first.featured_image
          -%}
          {%- if col_image -%}
            <img src="{{ col_image | image_url: width: 700 }}" alt="{{ collection.title | escape }}" loading="lazy">
          {%- endif -%}
          <div class="collections-list__card-info">
            <div class="collections-list__card-title">{{ collection.title }}</div>
            <div class="collections-list__card-count">{{ collection.products_count }} pieces</div>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
