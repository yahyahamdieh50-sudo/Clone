<div class="account-page">
  <h1 class="account-page__title">Addresses</h1>

  {%- for address in customer.addresses -%}
    <div class="account-address">
      {{ address | format_address }}
      {%- if address == customer.default_address -%}
        <p class="account-page__meta">Default address</p>
      {%- endif -%}
    </div>
  {%- endfor -%}

  <p class="account-page__meta">To add or edit addresses, please manage them during checkout or contact us.</p>
  <p><a href="{{ routes.account_url }}">&larr; Back to account</a></p>
</div>
