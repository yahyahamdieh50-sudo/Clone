<div class="account-page account-page--wide">
  <h1 class="account-page__title">{{ 'customer.account.title' | t }}</h1>
  <p class="account-page__meta">
    {{ customer.name }} · {{ customer.email }} ·
    <a href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a>
  </p>

  <h2 class="account-page__subtitle">{{ 'customer.account.orders' | t }}</h2>

  {%- if customer.orders.size > 0 -%}
    <table class="account-table">
      <thead>
        <tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th></tr>
      </thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr>
            <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: "%b %d, %Y" }}</td>
            <td>{{ order.financial_status_label }} / {{ order.fulfillment_status_label }}</td>
            <td>{{ order.total_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- else -%}
    <p>{{ 'customer.account.no_orders' | t }}</p>
  {%- endif -%}
</div>
