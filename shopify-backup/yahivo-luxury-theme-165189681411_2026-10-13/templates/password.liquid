<div class="account-page" style="text-align: center;">
  <h1 class="account-page__title">{{ shop.name | upcase }}</h1>
  <p class="account-page__meta">Opening soon. Enter the password to view the store.</p>

  {%- form 'storefront_password', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <label for="Password">Password</label>
    <input type="password" name="password" id="Password" required>
    <button type="submit" class="account-form__submit">Enter</button>
  {%- endform -%}
</div>
