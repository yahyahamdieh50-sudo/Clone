<!-- Luxury Bespoke Hero Section with 3D Particle Effect -->
{% stylesheet %}
  .luxury-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    background: #1a1a1a;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .luxury-hero__canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .luxury-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    max-width: 90%;
    pointer-events: none;
  }

  .luxury-hero__subtitle {
    font-family: 'Courier New', monospace;
    font-size: clamp(12px, 2vw, 16px);
    letter-spacing: 2px;
    color: #d4af37;
    margin-bottom: 40px;
    text-transform: uppercase;
    font-weight: 300;
  }

  .luxury-hero__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(48px, 8vw, 96px);
    line-height: 1.1;
    margin-bottom: 20px;
    font-weight: 400;
    letter-spacing: -1px;
  }

  .luxury-hero__title-secondary {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 6vw, 72px);
    color: #d4af37;
    font-style: italic;
    font-weight: 400;
  }

  .luxury-hero__cta {
    display: inline-block;
    margin-top: 50px;
    padding: 18px 48px;
    border: 2px solid white;
    color: white;
    text-decoration: none;
    font-family: 'Courier New', monospace;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    pointer-events: auto;
  }

  .luxury-hero__cta:hover {
    background: white;
    color: #1a1a1a;
    transform: scale(1.02);
  }

  .luxury-hero__scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    letter-spacing: 2px;
    color: #888;
    text-transform: uppercase;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @media (max-width: 768px) {
    .luxury-hero {
      height: 80vh;
      min-height: 600px;
    }

    .luxury-hero__cta {
      padding: 14px 36px;
      font-size: 12px;
    }
  }
{% endstylesheet %}

<div class="luxury-hero">
  <canvas id="particleCanvas" class="luxury-hero__canvas"></canvas>

  <div class="luxury-hero__content">
    <div class="luxury-hero__subtitle">
      {{ section.settings.subtitle }}
    </div>

    <h1 class="luxury-hero__title">
      {{ section.settings.title_line1 }}
      <div class="luxury-hero__title-secondary">
        {{ section.settings.title_line2 }}
      </div>
    </h1>

    <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="luxury-hero__cta">
      {{ section.settings.cta_text }}
    </a>
  </div>

  <div class="luxury-hero__scroll">
    {{ section.settings.scroll_text }}
  </div>
</div>

{% javascript %}
  class ParticleHero {
    constructor(canvasId) {
      this.canvas = document.getElementById(canvasId);
      this.ctx = this.canvas.getContext('2d');
      this.particles = [];
      this.particleCount = 800;
      this.mouse = { x: 0, y: 0 };

      this.resizeCanvas();
      this.init();
      this.animate();

      window.addEventListener('resize', () => this.resizeCanvas());
      window.addEventListener('mousemove', (e) => {
        this.mouse.x = e.clientX;
        this.mouse.y = e.clientY;
      });
    }

    resizeCanvas() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
    }

    init() {
      this.particles = [];

      // Create particle grid for human silhouette
      const centerX = this.canvas.width / 2;
      const centerY = this.canvas.height / 2;
      const scale = Math.min(this.canvas.width, this.canvas.height) / 400;

      // Simple human figure geometry (head, body, arms, legs)
      const humanGeometry = [
        // Head
        { x: 0, y: -120, size: 30 },
        // Body
        { x: 0, y: -40, size: 20 },
        { x: 0, y: 20, size: 20 },
        { x: 0, y: 80, size: 18 },
        // Left arm
        { x: -50, y: -20, size: 15 },
        { x: -80, y: 10, size: 12 },
        // Right arm
        { x: 50, y: -20, size: 15 },
        { x: 80, y: 10, size: 12 },
        // Left leg
        { x: -25, y: 100, size: 12 },
        { x: -25, y: 140, size: 12 },
        // Right leg
        { x: 25, y: 100, size: 12 },
        { x: 25, y: 140, size: 12 },
      ];

      for (let point of humanGeometry) {
        for (let i = 0; i < 60; i++) {
          const angle = Math.random() * Math.PI * 2;
          const distance = Math.random() * (point.size * scale);

          this.particles.push({
            x: centerX + (point.x * scale) + Math.cos(angle) * distance,
            y: centerY + (point.y * scale) + Math.sin(angle) * distance,
            vx: (Math.random() - 0.5) * 0.5,
            vy: (Math.random() - 0.5) * 0.5,
            size: Math.random() * 2 + 1,
            opacity: Math.random() * 0.7 + 0.3,
            life: Math.random() * 100 + 50,
            maxLife: Math.random() * 100 + 50,
          });
        }
      }
    }

    animate() {
      this.ctx.fillStyle = 'rgba(26, 26, 26, 0.1)';
      this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

      const centerX = this.canvas.width / 2;
      const centerY = this.canvas.height / 2;

      for (let particle of this.particles) {
        // Update position
        particle.x += particle.vx;
        particle.y += particle.vy;

        // Gravity
        particle.vy += 0.01;

        // Mouse interaction
        const dx = this.mouse.x - particle.x;
        const dy = this.mouse.y - particle.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < 100) {
          const force = (100 - distance) / 100;
          particle.vx -= (dx / distance) * force * 0.3;
          particle.vy -= (dy / distance) * force * 0.3;
        }

        // Fade out over time
        particle.life -= 1;
        particle.opacity = (particle.life / particle.maxLife) * 0.8;

        // Draw particle
        this.ctx.fillStyle = `rgba(212, 175, 55, ${particle.opacity})`;
        this.ctx.beginPath();
        this.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
        this.ctx.fill();

        // Reset particles that fade out
        if (particle.life <= 0) {
          const angle = Math.random() * Math.PI * 2;
          const distance = 150 + Math.random() * 50;
          particle.x = centerX + Math.cos(angle) * distance;
          particle.y = centerY + Math.sin(angle) * distance;
          particle.life = particle.maxLife;
          particle.vx = (Math.random() - 0.5) * 0.5;
          particle.vy = (Math.random() - 0.5) * 0.5;
        }
      }

      requestAnimationFrame(() => this.animate());
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new ParticleHero('particleCanvas');
    });
  } else {
    new ParticleHero('particleCanvas');
  }
{% endjavascript %}

{% schema %}
{
  "name": "Luxury Hero",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (gold label)",
      "default": "YAHIVO · Bespoke Streetwear · UAE"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Title line 1",
      "default": "The Anatomy"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Title line 2 (gold italic)",
      "default": "of Style"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scroll hint",
      "default": "Scroll to explore"
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero"
    }
  ]
}
{% endschema %}
